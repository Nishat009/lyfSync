{
  "name": "@lifesync/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsup",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:local": "tsx scripts/local-db.ts",
    "vapid": "tsx scripts/vapid.ts",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "test": "tsx --env-file-if-exists=.env --test --test-concurrency=1 tests/*.test.ts"
  },
  "dependencies": {
    "@lifesync/shared": "0.1.0",
    "cookie-parser": "1.4.7",
    "express": "5.2.1",
    "express-rate-limit": "8.7.3",
    "google-auth-library": "11.3.2",
    "helmet": "8.3.0",
    "multer": "2.5.0",
    "nodemailer": "10.3.1",
    "pg": "8.23.1",
    "sharp": "0.35.5",
    "web-push": "^3.6.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.9",
    "@types/express": "5.0.6",
    "@types/multer": "2.2.0",
    "@types/node": "24.19.1",
    "@types/nodemailer": "8.0.1",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.0",
    "@types/web-push": "^3.6.4",
    "embedded-postgres": "18.4.0-beta.17",
    "supertest": "7.3.1",
    "tsup": "9.0.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
