# Copy to apps/server/.env

# PostgreSQL connection. For local development run `npm run db:local` (embedded Postgres) and use:
DATABASE_URL=postgres://postgres:postgres@localhost:54329/lifesync

# Public URL of the web app (CORS/origin checks and links in emails).
APP_URL=http://localhost:3000
PORT=4000

# Number of reverse proxies in front of the API (Render/Heroku-style: 1). Needed for correct rate limiting.
TRUST_PROXY=0

# Optional: Google sign-in. Create an OAuth client ID (Web) in Google Cloud Console and set the same
# value here and as NEXT_PUBLIC_GOOGLE_CLIENT_ID in apps/web/.env.local.
GOOGLE_CLIENT_ID=

# Optional: SMTP for verification, password-reset and invitation emails.
# Without it, emails are printed to the API console (development only).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=LifeSync <no-reply@example.com>

# Where uploaded files (avatars) are stored.
STORAGE_DIR=storage

# Optional: browser push notifications. Generate a key pair with `npm run vapid -w @lifesync/server`
# and paste the values here. Without them, push is disabled and in-app/email reminders still work.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# How often (seconds) the reminder scheduler checks for due reminders. 0 disables it.
SCHEDULER_INTERVAL_SECONDS=30
